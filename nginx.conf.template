# SPA fallback: unknown paths (client-side routes) serve index.html. The PWA manifest and
# service worker are plain static files under dist/, served as-is.
#
# T-12-5 (B-24): the same security headers vite.config.ts's `preview.headers` sends in dev-preview,
# for the real static build nginx serves in Docker's "full" profile (and whatever serves dist/ in
# prod). `always` so they're set on 4xx/5xx responses too, not just 200s. No AWS/CDN dependency --
# this app sets its own headers rather than assuming a future CloudFront policy.
#
# This is a TEMPLATE, not served directly: the connect-src placeholder below is filled in by
# scripts/render-nginx-conf.ts (run from the Dockerfile's build stage) from the same
# VITE_API_URL the build itself used, producing the real nginx.conf (gitignored -- review r1).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src __CONNECT_SRC__; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
