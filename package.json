{
  "name": "invai-floor",
  "version": "0.1.0",
  "private": true,
  "description": "InvAI production-floor PWA for tablets with barcode scanners",
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
