{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "files": {
    "includes": ["src/**", "e2e/**", "*.ts", "*.json", "!e2e/.report", "!e2e/.results"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
