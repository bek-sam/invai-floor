# Empty = same origin: `pnpm dev` proxies /rpc and /events to VITE_API_PROXY (default http://localhost:3000).
# Set a full URL when the API is on another origin (the backend must then allow this origin in CORS).
VITE_API_URL=
# Minutes of inactivity before the station locks back to the PIN screen.
VITE_AUTO_LOCK_MINUTES=10
